{
  "name": "rue-asha-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio and blog site, built from Markdown into static HTML.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --import tsx bin/build.ts",
    "check": "node --import tsx bin/check.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "markdown-it": "^15.0.2",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "5.0.1"
  }
}
