{"nodes": [{"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec", "label": "Functional Specification \u2014 U2 Blog", "file_type": "document", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_w1_render_writing_list", "label": "W1 \u2014 Render the Writing list", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_w2_render_post_page", "label": "W2 \u2014 Render a post page", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_w3_render_markdown_body", "label": "W3 \u2014 Render a Markdown body", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing runs in the reader's browser, keeping FR2.7 compatible with NFR2 and script-src 'none'"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_w4_construct_feed", "label": "W4 \u2014 Construct the feed", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feed carries summaries not bodies; drafts absent by construction because PostCatalog never yields one (BR1.7)"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_w5_writing_empty_state", "label": "W5 \u2014 Writing page with nothing published", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_screen_state_machine", "label": "Writing/Post screen-state machine", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No loading or error state: pages served complete (NFR2) and a failed build writes nothing (BR4.4)"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_br8_1", "label": "BR8.1 \u2014 Image alt text is an unenforced authoring rule", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earlier draft made missing alt a build failure, which would silently reverse the accessibility-checklist position; the declined automated scan means nothing detects it"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_br8_2", "label": "BR8.2 \u2014 Unknown fence language fails build; unlabelled fence renders plain", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlabelled fence is a choice, misspelled label is always a mistake; PRIMARY/FALLBACK known-language resolution keeps rule buildable against any highlighter"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_br8_3", "label": "BR8.3 \u2014 Atom feed entries: summary + canonical-URL identity", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carrying bodies requires escaping rendered HTML into the feed, a silent-breakage source nothing would detect"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_br8_4", "label": "BR8.4 \u2014 Two 'All posts' links per post page", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second link after body exists because a long post leaves the first far off screen (FR2.8)"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_br8_5", "label": "BR8.5 \u2014 Writing page lists every post once with title, summary, date", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_br8_6", "label": "BR8.6 \u2014 Each Writing row is a single link target", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meets FR2.3, NFR7 44px floor once, and keeps one tab stop per row"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_br8_7", "label": "BR8.7 \u2014 Post page carries title, summary, date and body", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "U1 BR2.1\u2013BR2.3 only guarantee fields exist in the source, not that the page renders them"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_rule_enforcement_table", "label": "What actually catches a BR8.x violation", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only BR8.2 fails a build; the FR2.1/2.3/2.4 rendering rules have no automated check"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_fr4_3_incidental_effect", "label": "FR4.3 recorded as incidental effect, owned by U1", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recording FR4.3 as U2-completed would put the same requirement in two units' completion tables"}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_u2a1_highlighter_language_query", "label": "U2A1 \u2014 Highlighter can report its known languages", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_u2a2_summary_as_feed_content", "label": "U2A2 \u2014 One-line summary suits feed entry content", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u2_blog_functional_design_functional_spec_u2a3_fixed_feed_path", "label": "U2A3 \u2014 Feed lives at a fixed path that never changes", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u2-blog/functional-design/functional-spec.md", "source_lo