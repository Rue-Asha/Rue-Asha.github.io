{"nodes": [{"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_developer_agent_contribution", "label": "Developer Agent Practices Contribution", "file_type": "document", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_aidlc_publish_root_hazard", "label": "aidlc/ Inside Publish Root Hazard", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repo is both GitHub Pages site and AI-DLC workspace; Jekyll publishes non-underscore/dot paths, so aidlc/ would be served. PU-1 acceptance: GET /aidlc/ returns 404."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_four_layer_boundary", "label": "Content / Templates / Styles / Build Config Layers", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content files carry no template logic and templates carry no content, so posts survive a generator change."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_reusable_include_rule", "label": "Presentation Capability Becomes Named Include", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents inline-styled markup pasted into posts from spreading site presentation across prose files."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_page_bundle_layout", "label": "One Directory Per Post With Its Images", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting or moving a post takes its images along; a global images folder accumulates unprovable orphans."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_immutable_url_slugs", "label": "Published URL Slugs Never Change", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub Pages has no server-side redirects and no analytics would reveal broken shared links."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_front_matter_date_ordering", "label": "Order By Front-Matter Date, Not mtime", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git does not preserve mtimes, so CI checkouts would silently reorder the Writing list."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_build_fails_on_malformed_content", "label": "Build Fails Loudly On Malformed Front Matter", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skip-on-error turns a typo into silent content loss behind a green build; this is a stack-selection criterion rehearsed in PU-1."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_required_field_schema", "label": "Post / Project Required Front-Matter Schema", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post: title, summary, date. Project: name, summary, year, type, tools, repo; live URL optional and omitted when absent."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_practices_discovery_contributions_aidlc_developer_agent_internal_links_blocking", "label": "Internal Links Blocking, External Links Report-Only", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/practices-discovery/contributions/aidlc-developer-agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dead third-party URL is someone else's outage and must not stop publishing."}, {"id": "aidlc_spaces_default