{"nodes": [{"id": "readme", "label": "rue-asha.github.io README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_static_site_generator", "label": "TypeScript static site generator (src/)", "file_type": "concept", "source_file": "README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content is files and the repository is the CMS; there is no authoring interface and there will not be one."}, {"id": "readme_single_act_publishing", "label": "Single-act publishing (write, commit, push)", "file_type": "rationale", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A GitHub Actions workflow builds and deploys on push; nothing else is required of the author after the push."}, {"id": "readme_pre_push_check_set", "label": "Three blocking pre-push checks (build, every content file produces a page, internal links resolve)", "file_type": "rationale", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks run locally before the push so a failure is in front of the author while it can still be fixed; external links are deliberately unchecked because a dead third-party URL is somebody else's outage."}, {"id": "readme_front_matter_contract", "label": "Post/Project front matter contract", "file_type": "concept", "source_file": "README.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing required field fails the build naming file and field; absent optional field is omitted rather than rendered empty; present-but-wrong-shape optional field still fails so it cannot vanish silently."}, {"id": "readme_stable_slugs", "label": "Published slugs never change (file name is the URL)", "file_type": "rationale", "source_file": "README.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renaming breaks every shared link and GitHub Pages has no server-side redirects; ordering reads front matter date, never mtime."}, {"id": "readme_instrument_panel_look", "label": "Instrument-panel visual direction (site.css, IBM Plex, single teal signal colour, light-only)", "file_type": "concept", "source_file": "README.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_content_security_policy", "label": "Content-security policy (style-src 'self', script-src 'none')", "file_type": "rationale", "source_file": "README.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No style attribute is ever emitted because inline styles would be dropped; nothing runs in the reader's browser so no script-dependent controls exist; nothing a reader loads comes from another server."}, {"id": "readme_site_config", "label": "site.config.ts editorial copy and derived status readout", "file_type": "code", "source_file": "README.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post and project counts are derived by the build so they cannot go stale."}, {"id": "readme_github_pages_deployment", "label": "GitHub Pages deployment via Actions (main is production, no staging)", "file_type": "concept", "source_file": "README.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A push to main is the approval; an incomplete build deploys nothing; rollback is git revert; looking at the live site is the only failure detection."}, {"id": "readme_security_workflow", "label": "Security workflow