{"nodes": [{"id": "claude_aidlc_common_protocols_stage_protocol_construction", "label": "Construction Protocol Module (stage-protocol-construction.md)", "file_type": "document", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_walking_skeleton_gate", "label": "Walking-Skeleton Stage Gate", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First in-scope Construction EXECUTE stage (isSkeletonGateStage) always presents a stage-level approval gate regardless of autonomy; an autonomous grant waives only later gates, never this first human review."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_skeleton_stance_classification", "label": "Walking-Skeleton Stance Classification (gate: unresolved)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L494", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No parser can derive the stance from free-form practices prose, so the conductor classifies org.md -> team.md -> project.md (most specific wins) as on/off/scope-dependent and reports --skeleton-stance."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_construction_autonomy_mode", "label": "Construction Autonomy Mode", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The human's grant governing remaining Construction stage gates; escalation to autonomous requires a fresh human turn so an unattended run cannot grant itself more autonomy."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_ladder_prompt", "label": "Autonomy Ladder Prompt", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_halt_and_ask_on_failure", "label": "Halt-and-Ask on Code Generation Failure", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failure always halts and asks regardless of autonomy mode; retry/skip/abort preserve the worktree."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_build_and_test_failure_loop_back", "label": "Build-and-Test Failure Loop-Back (3.6 -> 3.5)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sanctioned exception to the no-emergent-behavior rule: a failed build-and-test whose root cause is in generated code returns to code-generation instead of dead-ending at the gate."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_loop_back_log", "label": "Loop-Back Log Ledger (max 3 per intent)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Artifact ledger in test-results.md chosen over parsing STAGE_JUMPED rows because it survives the backward jump, is colocated with the diagnosis, and is readable at the final gate."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_re_entry_settlement_and_review", "label": "Re-entry Settlement and Review (artifact-only vs receipt-mode)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_loop_back_swarm_interaction", "label": "Loop-Back Swarm Interaction (cheap check-first path)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L227", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After prepare, check every unit first so already-green units need no builder turn; degrades gracefully to full re-dispatch if the prior attempt never merged."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_planned_bolt_major_ceremony", "label": "Planned Bolt-Major Ceremony (non-executable future state)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L305", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as design intent until a later walk consumes bolt-plan.md; the shipped walk is stage-major."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_engine_driven_per_unit_iteration", "label": "Engine-Driven Per-Unit Iteration", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-unit gates are suppressed (gate:false) and one stage-level gate is presented only after the last Unit settles, so approval cannot be reached until every Unit is built."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_unit_lifecycle_receipts", "label": "Unit Lifecycle Receipts (unit start/complete/pause/resume)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L332", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once any receipt exists the stage stays in receipt mode; artifact files alone no longer settle a Unit, so stale or partial Units can't be mistaken for done."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_run_floor", "label": "Stage-Attempt Run Floor token", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L332", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Receipt validity is decided by attempt floor and content bindings, never by shard or row order; ambiguous equal-second boundaries yield a deterministic AMBIGUOUS floor."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_per_unit_batch_waves", "label": "Per-Unit Batch Waves (directive.wave)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code Generation stays wave-ineligible because it writes the shared workspace and hard-stops for Plan Approval."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_unit_major_iteration", "label": "Unit-Major Construction Iteration (opt-in)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L342", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First working code lands after one Unit's design rather than after every Unit's; gates unchanged in count but fire late as a cascade."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_team_owned_unit_progress", "label": "Team-Owned Unit Progress and Gates", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L344", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_team_unit_claims", "label": "Team Unit Claims and Scoped Checkouts", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L371", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_pinned_unit_merge_back", "label": "Pinned Unit Merge-Back", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L388", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires merge strategy so the reviewed pinned OID remains a direct parent; squash/rebase refused."}, {"id": "claude_aidlc_common_protocols_stage_protocol_construction_autonomous_code_generation_plan_contract", "label": "Autonomous Code Generation Plan Contract (\u00a712b)", "file_type": "rationale", "source_file": ".claude/aidlc-common/protocols/stage-protocol-construction.md", "source_location": "L427", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "invoke-swarm changes where generation runs, not whether planning and fingerprinted Plan Approval happen; worker briefs start with the testing-posture brief markers verbatim."}], "edges": [{"source": "claude_aidlc_common_protocols_stage_protocol_construction", "target": "claude_aidlc_common_protocols_stage_protocol_construction_walking_skeleton_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/aidlc-c