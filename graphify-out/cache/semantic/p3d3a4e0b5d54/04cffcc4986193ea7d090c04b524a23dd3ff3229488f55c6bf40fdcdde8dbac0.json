{"nodes": [{"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec", "label": "U5 Visual Direction Functional Spec", "file_type": "document", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "U5 is a ui unit that changes no behaviour or content; it applies the design system to every page type, so it depends on the page-type units."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_w1_apply_the_treatment", "label": "W1 Apply the treatment", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_w2_verify_the_treatment", "label": "W2 Verify the treatment (keyboard walkthrough)", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 4 (tab order matches visual order) is the one U5 uniquely threatens; step 9 (contrast re-read) has no automation because the accessibility scan was declined."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_w3_font_arrives_late", "label": "W3 Reader loads page before font arrives", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A font failure degrades appearance only; nothing is hidden waiting for it, so no loading state (NFR2)."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_font_loading_states", "label": "Font loading states (FallbackFont -> RealFont)", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_editorial_technical_registers", "label": "Editorial and technical registers", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_stylesheet", "label": "Stylesheet (single site stylesheet)", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_self_hosted_variable_font", "label": "Self-hosted variable font (Latin subset)", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_1", "label": "BR11.1 Standalone links clear 44px hit area below breakpoint", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clear space is measured between hit areas, not glyph boxes, so padding pushes the 16px gap outward; one-sided padding rejected because it makes the hit area asymmetric. One shared rule cannot be forgotten for a new element."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_2", "label": "BR11.2 Preloaded font with metric-matched fallback; text never hidden", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hiding text is the NFR2-forbidden loading state through another door; metric match keeps reflow small."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_3", "label": "BR11.3 One stylesheet; register is one class on the page root", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate files per register would drift into two design systems; accepted cost is that editorial changes touch a file every page loads."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_4", "label": "BR11.4 Nothing this unit adds is fetched from another server", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a font is the usual way a third-party request enters a site; U1's CSP breaks the page visibly at runtime."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_5", "label": "BR11.5 Colour change re-opens measured contrast table by hand", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing detects a contrast regression since the automated accessibility scan was declined; stated so the obligation has a name."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_6", "label": "BR11.6 One breakpoint; phone layout is desktop contracted", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserves rail stacking above body, no new hit target on contraction, top bar always visible with no hamburger. Projects rows are the requirement-level exception (FR3.5, BR9.2)."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_7", "label": "BR11.7 Styling never moves focusable elements or removes focus indicator", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promoted from assumption U5A4 so NFR1 tab-order and no-focus-trap conditions are stated as an obligation, not hoped for."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_br11_8", "label": "BR11.8 Every list row clears 44px at phone width via own padding", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes the interaction-spec token arithmetic (16+24+16=56px) an obligation so a token change cannot silently drop rows below the floor."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_manual_only_enforcement", "label": "No BR11 rule verified by the pre-push check set", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distribution is the honest consequence of declining the automated accessibility scan; BR11.4 is only browser-enforced at runtime."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_nfr5_not_delivered", "label": "NFR5 deliberately not delivered (no performance budget invented)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_traceability_check_limitation", "label": "Traceability check false positives for ui units", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The check resolves BRx.y against a sibling rules.md that ui units do not produce, and compares upstream_ids against all FR ids when stories.md is absent; advisory, left failing rather than padded."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_u5a1", "label": "U5A1 Metric-close fallback stack exists", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_u5a2", "label": "U5A2 44px padding invisible on standalone links", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_u5a3", "label": "U5A3 One breakpoint enough for every page type", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_u5a4", "label": "U5A4 Styling does not reorder visually (promoted to BR11.7)", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_u5oq1", "label": "U5OQ1 Which font face?", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_u5_visual_direction_functional_design_functional_spec_u5oq2", "label": "U5OQ2 Nothing enforces BR11.5", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/u5-visual-direction/functional-design/functional-spec.md", "source_location": null, "s