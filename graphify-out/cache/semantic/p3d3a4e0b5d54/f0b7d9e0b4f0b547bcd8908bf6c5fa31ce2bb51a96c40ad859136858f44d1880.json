{"nodes": [{"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions", "label": "Architecture Decision Record (decisions.md)", "file_type": "document", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_001", "label": "ADR-001: Write the build rather than adopt a static-site generator", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock generators skip or warn on malformed content; FR1.5 requires the build to fail naming file and field. Cost: discovery, parsing, rendering, templating, output maintained forever."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_002", "label": "ADR-002: Two content entities, Post and Project", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Field sets change independently; one ContentItem with kind would repeat the same conditional in validation, listing, feed and templates."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_003", "label": "ADR-003: Keep Markdown rendering out of the shared-functions component", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps ContentTransforms pure as the single NFR12 coverage target; isolates third-party libs where a browser-side highlighter would break NFR2/NFR3; different change rates."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_004", "label": "ADR-004: Validation runs inside the build; one runner runs all three checks", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No second command to forget and no way to bypass validation; one runner keeps pre-push and workflow backstop from drifting."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_005", "label": "ADR-005: Publish through a GitHub Actions workflow in this repository", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A self-written build cannot run on the built-in Jekyll Pages build; deliberate departure from the team preference, made proportionate by four workflow controls."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_006", "label": "ADR-006: One rendering component owns shell, seven templates, and includes", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Templates are configuration more than logic; accessibility contract and CSP tag get one owner. Cost: PageRenderer realises most of FR2-FR5."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_007", "label": "ADR-007: One component owns the content-directory boundary", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C2 makes the aidlc/.claude exclusion security-shaped, so the rule must have exactly one home."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_008", "label": "ADR-008: Projects ordered featured-first, year desc, slug asc", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Total ordering never filters (FR3.1); slug tie-break gives determinism across clones like FR2.2 for posts."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_009", "label": "ADR-009: Reconcile the catalogue to the built system by question, not adoption", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adopting code wholesale makes the design a changelog; reverting code is cost with no requirement behind it."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_requirements_oq3_generator_question", "label": "Requirements OQ3 (which generator) \u2014 closed as 'none'", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_four_workflow_controls", "label": "Four required GitHub Actions workflow controls", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit permissions, SHA-pinned actions, no pull_request_target, no fetch outside lockfile \u2014 makes running our code on every push proportionate."}], "edges": [{"source": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions", "target": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_001", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "weight": 1.0}, {"source": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions", "target": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_002", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "weight": 1.0}, {"source": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions", "target": "aidlc_spaces_default_intents_260921_portfolio_blog_site_inception_domain_design_decisions_adr_003", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/inception/domain-design/decisions.md", "source_location": null, "w