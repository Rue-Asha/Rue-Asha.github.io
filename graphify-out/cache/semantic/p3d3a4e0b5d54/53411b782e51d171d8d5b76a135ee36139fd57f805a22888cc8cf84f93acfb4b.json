{"nodes": [{"id": "content_posts_my_own_ai_workflow_index", "label": "Post: My own AI workflow", "file_type": "document", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_posts_my_own_ai_workflow_index_vibe_coding", "label": "Vibe coding", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vibe-coded dashboard and party-games apps were 'done' but flaky; lacking SE fundamentals motivated researching structured AI workflows instead of switching fields."}, {"id": "content_posts_my_own_ai_workflow_index_something_worth_deploying", "label": "Something worth deploying (motivation)", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DevOps practice needs a meaningful app to deploy and maintain, so building own apps keeps commitment."}, {"id": "content_posts_my_own_ai_workflow_index_ai_dlc", "label": "AI-Driven Development Lifecycle (AI-DLC)", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI drives (breaks intent into units, proposes plans, asks questions); humans approve at decision points. Built for teams; too costly in tokens and time for a solo dev (this site: 33 stages, 14 role agents, 240 artifact files for 14 commits)."}, {"id": "content_posts_my_own_ai_workflow_index_mob_elaboration", "label": "Mob Elaboration", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_posts_my_own_ai_workflow_index_units_of_work", "label": "Units of work handed to subagents", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps each context undiluted; every agent is the expert for its one task."}, {"id": "content_posts_my_own_ai_workflow_index_artifacts_as_memory", "label": "Artifacts as memory", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisted plans and decisions act as AI memory across sessions/teams; addresses session amnesia."}, {"id": "content_posts_my_own_ai_workflow_index_intent_exploration", "label": "Exploring the intent first", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saves iterations and surfaces unconsidered aspects."}, {"id": "content_posts_my_own_ai_workflow_index_minimum_viable_harness", "label": "Minimum Viable Harness (Raihan Alam talk)", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Machinery around an agent: sensors, gates, backpressure. Motto: Move fast. Bring proof."}, {"id": "content_posts_my_own_ai_workflow_index_agent_failure_modes", "label": "Agent failure modes (long feedback loops, false done, session amnesia, unable to start repo)", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_posts_my_own_ai_workflow_index_session_amnesia", "label": "Session amnesia", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_posts_my_own_ai_workflow_index_sensors", "label": "Sensors (deterministic evidence)", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensors decide whether an implementation is correct; led to test-driven development with AI."}, {"id": "content_posts_my_own_ai_workflow_index_harness_gates", "label": "Harness gates (enforced checks)", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_posts_my_own_ai_workflow_index_backpressure", "label": "Backpressure (block progress until proof exists)", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_posts_my_own_ai_workflow_index_openspec", "label": "OpenSpec (spec-driven development tool)", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already handled idea-to-plan well, so flow wraps it instead of replacing it; specs merge into living specs."}, {"id": "content_posts_my_own_ai_workflow_index_living_specs", "label": "Living specs", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_posts_my_own_ai_workflow_index_flow_skill", "label": "flow (Claude Code workflow skill)", "file_type": "concept", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo adaptation of AI-DLC + harness ideas: fewer human interventions, checks enforced by sensors."}, {"id": "content_posts_my_own_ai_workflow_index_orchestrator_session", "label": "Orchestrator-only main session with subagent briefs", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main session reads only reports, never source/diffs; scope exploration stays a human conversation."}, {"id": "content_posts_my_own_ai_workflow_index_tracks", "label": "Triage tracks: feature / tweak / fix / chore", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not every change deserves the full process."}, {"id": "content_posts_my_own_ai_workflow_index_live_flag", "label": "live flag for running infrastructure", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live steps never run without approval; dry run is part of the evidence."}, {"id": "content_posts_my_own_ai_workflow_index_appetite", "label": "Appetite (Shape Up time budget)", "file_type": "rationale", "source_file": "content/posts/my-own-ai-workflow/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Budget for how much time work is worth; outgrowing it renegotiates scope."}, {"id": "content_posts_my_own_ai_workflow_index_three_gates", "label": "Three gates: 