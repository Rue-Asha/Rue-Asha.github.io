{"nodes": [{"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_build_and_test_security_test_instructions", "label": "Security Test Instructions", "file_type": "document", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/build-and-test/security-test-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_build_and_test_security_test_instructions_static_site_threat_model", "label": "Static Site Threat Model", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/build-and-test/security-test-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No server, input, session or storage, so injection/auth/session flaws are removed by absence; remaining risks are account compromise, committed credentials, vulnerable deps, third-party loads, malicious action versions."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_build_and_test_security_test_instructions_content_security_policy_check", "label": "Content-Security-Policy Check (NFR4)", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blog-site/construction/build-and-test/security-test-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Policy fixed character-for-character in site.config.ts; script-src 'none' is load-bearing and makes DOM-based XSS unable to fire."}, {"id": "aidlc_spaces_default_intents_260921_portfolio_blog_site_construction_build_and_test_security_test_instructions_third_party_request_check", "label": "Third-Party Request Check (NFR3)", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260921-portfolio-blo